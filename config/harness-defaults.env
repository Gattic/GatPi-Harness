# Canonical guarded defaults for the Pi harness.
# Loaded before harness extensions. Existing process environment values win.

# Safety, privacy, and observability.
PI_POLICY_ENFORCER=1
PI_POLICY_GATE=1
PI_POLICY_ENFORCER_MODE=block
PI_PRIVACY_GUARD=1
PI_EXTENSION_TELEMETRY=1
PI_TOOL_SURFACE_ROUTER=1
PI_TOOL_CHURN_GUARD=1
# Native hybrid CodeMode is available by default; PI_CODEMODE=0 opts out.
PI_CODEMODE=1
PI_TRACE_ENABLED=1
PI_TRACE_CAPTURE_PAYLOADS=0
PI_TRACE_MAX_TOTAL_BYTES=134217728

# Reasoning scaffold and bounded context.
PI_COGNITIVE_AUTOMATION=1
PI_REASONING_RUNTIME_ENABLED=1
PI_COGNITIVE_MEMORY_ENABLED=1
PI_COGNITIVE_CONTEXT_ENABLED=1
PI_COGNITIVE_ANCHORING_ENABLED=1
PI_COGNITIVE_ENTROPY_ENABLED=1
PI_COGNITIVE_AUTO_INJECT=1
PI_COGNITIVE_HEADLESS_INJECT=0
PI_COGNITIVE_INJECT_MAX_CHARS=2500
PI_COGNITIVE_AUTO_VERIFY=0
PI_COGNITIVE_TIMING=1
PI_COGNITIVE_ORCHESTRATION_ENABLED=0
PI_COGNITIVE_AUTO_BRANCH=0
PI_COGNITIVE_AUTO_CONSOLIDATE=0
PI_REASONING_AUTO_PRUNE_AUTOMATED=1

# Authorized implementation turns continue when the model stops on an
# unevidenced "budget"/limit or reports unfinished required work. Read-only
# modalities (investigation, planning, verification, answer) are never
# enforced, and the bound keeps an unsatisfiable task from looping. A bound of
# 0 disables continuations while keeping the decision trail inspectable.
PI_COMPLETION_ENFORCEMENT=1
PI_COMPLETION_MAX_CONTINUATIONS=8

# Manual Roles v2 delegation is available in normal sessions.
# Enabling explicit topology/task tools does not start workers automatically.
# Automatic routing and the worker canary remain separately opted in.
PI_ROLE_RUNTIME_VERSION=2
PI_ROLE_MUTATION=isolated
PI_ROLE_ROLLOUT_STAGE=R5
PI_ROLE_FIELD_PILOT=0
PI_MULTI_AGENT_TOPOLOGIES_ENABLED=1
# Specialist tasks inherit parent inference without task/run budgets or extra UI
# confirmation. Optional schema-v2 project policy supplies executable checkers.
PI_SPECIALIST_TASKS_ENABLED=1
PI_TOPOLOGY_AUTO_ROUTE=off
PI_ROLE_WORKER_SHADOW_CANARY=0
PI_SUBAGENT_RPC_CONCURRENCY=2
# `local` is a placeholder provider id; define it in ~/.pi/agent/models.json.
PI_ROLE_MODEL_PLANNER=local/DeepSeek-V4.1-Flash-1017
PI_ROLE_THINKING_PLANNER=high
PI_ROLE_MODEL_RESEARCHER=local/DeepSeek-V4.1-Flash-1017
PI_ROLE_THINKING_RESEARCHER=medium
PI_ROLE_MODEL_REVIEWER=local/DeepSeek-V4.1-Flash-1017
PI_ROLE_THINKING_REVIEWER=high
PI_ROLE_MODEL_CODER=local/DeepSeek-V4.1-Flash-1017
PI_ROLE_THINKING_CODER=high
PI_ROLE_MODEL_VERIFIER=local/DeepSeek-V4.1-Flash-1017
PI_ROLE_THINKING_VERIFIER=low
PI_ROLE_MODEL_REFACTORER=local/DeepSeek-V4.1-Flash-1017
PI_ROLE_THINKING_REFACTORER=high
PI_ROLE_MODEL_BENCHMARK=local/DeepSeek-V4.1-Flash-1017
PI_ROLE_THINKING_BENCHMARK=medium
PI_ROLE_MODEL_EVIDENCE_AUDITOR=local/DeepSeek-V4.1-Flash-1017
PI_ROLE_THINKING_EVIDENCE_AUDITOR=high
PI_ROLE_MODEL_WORKER=local/DeepSeek-V4.1-Flash-1017
PI_ROLE_THINKING_WORKER=low
# Specialist 3D producer: inherit the parent session model, but pin its effort so
# procedural geometry work does not spend the whole output budget on reasoning.
# An explicit launch override (PI_ROLE_MODEL_3D_MODELER=<provider/model>) wins.
PI_ROLE_THINKING_3D_MODELER=medium

# Owned child-process memory guardrails.
PI_MANAGED_PROCESS_MAX_RSS_MB=6144
PI_MANAGED_PROCESS_RSS_POLL_MS=2000
PI_MANAGED_PROCESS_TERM_GRACE_MS=5000

# Operator-authorized selective capture/recall; field effectiveness is unproven.
# M2–M5 evidence promotion, verified claims and maintenance remain separate.
PI_PROJECT_MEMORY_STAGE=M1
PI_PROJECT_MEMORY_WRITES=1
PI_PROJECT_MEMORY_AUTOMATIC=1
PI_PROJECT_MEMORY_AUTO_SAVE=1
# Diagnostics are metadata-only and independent of promotion.
PI_PROJECT_MEMORY_DIAGNOSTICS=1
# Learning collection is metadata-only; promotion and maintenance stay manual.
PI_EXECUTION_OUTCOME_CAPTURE=1
PI_EXECUTION_OUTCOME_LEARNING=1
PI_EXECUTION_OUTCOME_SKILLS=1
PI_LEARNING_AUTO_INGEST=1
PI_LEARNING_AUTO_INGEST_SOURCES=verification,topology,skill,evidence,execution,runtime,policy,privacy
PI_MEMORY_MAINTENANCE_PREVIEW_INTERVAL_HOURS=0
PI_HERMES_ADVISORY=1
PI_HERMES_SKILL_AUTO_DRAFT=0

# Retrieval stays advisory; local index freshness and intent-gated status collection are automatic.
PI_CODE_CONTEXT_MODE=advisory
PI_CODEGRAPH_ADVISORY=1
PI_CODEGRAPH_AUTO_SYNC=1
PI_SEMGREP_ADVISORY=0
PI_OBSIDIAN_AUTO_AWARE=0
PI_OBSIDIAN_AUTO_STATUS=1
PI_PROMPT_SUGGESTIONS_REFINE=auto
PI_PROMPT_SUGGESTIONS_CONTEXT_CHARS=6000

# DeepSeek (local provider) requests join the shared Redis request queue before they are sent.
# PI_QUEUE=0 sends them directly to the model instead.
PI_QUEUE=1

# Explicit orchestration and monitoring surfaces remain available without automatic execution.
PI_AUTOMATION_LOOP=1
PI_RUN_MONITOR=1
PI_RUN_MONITOR_INTENT_TELEMETRY=1

# Compact active context before it becomes a process-memory hazard. Session
# JSONL stays append-only; compaction adds a checkpoint instead of deleting it.
PI_COMPACTION_PROACTIVE=1
PI_COMPACTION_PROACTIVE_PERCENT=80
PI_COMPACTION_PROACTIVE_MAX_CHARS=8388608

# Oversized tool results are bounded by src/tool-output-bounds.js: head caps keep a
# continuation pointer (read offset, docs/debug/roadmap paging), tail caps keep
# failures and pi's truncation footer, structured caps compact JSON field-first.
# The canary set is exactly the policy tool set; model exposure remains off.
PI_OUTPUT_COMPACTOR_MODE=canary
PI_OUTPUT_COMPACTOR_CANARY_TOOLS=ast_refactor,ast_search,bash,bg_run,code_context,codegraph_context,codegraph_query,create_subagent,debug_ledger,docs_lookup,lsp,memory_curator,memory_explorer,read,roadmap_update,semgrep_codegraph,specialist_tasks,test_gap_planner,test_runner
PI_OUTPUT_COMPACTOR_MAX_CHARS=2400
PI_OUTPUT_COMPACTOR_MODEL_TOOL=0
PI_PORTFOLIO_EXPERIMENTAL_TOOLS=0
