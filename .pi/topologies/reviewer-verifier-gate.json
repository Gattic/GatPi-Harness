{
  "topologies": [
    {
      "topologyId": "project-reviewer-verifier-gate",
      "name": "Reviewer Verifier Gate",
      "description": "Review first, then run verification as a gate.",
      "executionMode": "sequential",
      "failurePolicy": "fail-fast",
      "aggregationPolicy": "last",
      "nodes": [
        {
          "id": "review",
          "roleId": "reviewer",
          "task": "Review {{task}}",
          "contextPolicy": "dependency-neighborhood",
          "executionMode": "subagent",
          "roleContractVersion": "role-v2",
          "workspacePolicy": "shared-readonly",
          "mutationPolicy": "forbidden",
          "budget": {
            "maxModelCalls": 8,
            "maxToolCalls": 48,
            "wallClockMs": 180000,
            "maxResultChars": 12000,
            "maxQueueWaitMs": 180000,
            "maxLengthContinuations": 0
          },
          "outputSchema": {
            "type": "object",
            "required": [
              "summary",
              "findings",
              "evidence"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "proposedPatch": {
                "anyOf": [
                  {
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "verification": {
                "type": "object",
                "required": [
                  "status",
                  "evidence"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "unchecked",
                      "passed",
                      "failed"
                    ]
                  },
                  "evidence": {
                    "type": "array"
                  }
                }
              }
            }
          },
          "requiresTypedResult": true
        },
        {
          "id": "verify",
          "roleId": "verifier",
          "task": "Verify reviewed changes for {{task}}",
          "contextPolicy": "summarized",
          "executionMode": "subagent",
          "roleContractVersion": "role-v2",
          "workspacePolicy": "isolated-worktree",
          "mutationPolicy": "isolated-only",
          "budget": {
            "maxModelCalls": 8,
            "maxToolCalls": 64,
            "wallClockMs": 300000,
            "maxResultChars": 12000,
            "maxQueueWaitMs": 180000,
            "maxLengthContinuations": 0
          },
          "outputSchema": {
            "type": "object",
            "required": [
              "summary",
              "evidence",
              "verification"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "proposedPatch": {
                "anyOf": [
                  {
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "verification": {
                "type": "object",
                "required": [
                  "status",
                  "evidence"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "unchecked",
                      "passed",
                      "failed"
                    ]
                  },
                  "evidence": {
                    "type": "array"
                  }
                }
              }
            }
          },
          "requiresTypedResult": true
        }
      ],
      "edges": [
        {
          "source": "review",
          "target": "verify",
          "condition": "ok"
        }
      ],
      "terminalNodes": [
        "verify"
      ],
      "schemaVersion": 2,
      "roleRuntimeVersion": 2,
      "contractVersion": "role-v2",
      "resultSchemaVersion": 2,
      "metadata": {
        "requiresTypedResults": true,
        "provenance": {
          "source": "project-config",
          "file": ".pi/topologies/reviewer-verifier-gate.json",
          "version": 2
        }
      }
    }
  ]
}
