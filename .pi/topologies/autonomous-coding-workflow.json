          "id": "research",
          "roleId": "researcher",
          "task": "Research code and docs relevant to {{task}}",
          "contextPolicy": "task-only",
          "memoryPolicy": "read-only",
          "executionMode": "subagent",
          "roleContractVersion": "role-v2",
          "workspacePolicy": "shared-readonly",
          "mutationPolicy": "forbidden",
          "budget": {
            "maxModelCalls": 6,
            "maxToolCalls": 48,
            "wallClockMs": 180000,
            "maxResultChars": 12000,
            "maxQueueWaitMs": 180000,
            "maxLengthContinuations": 0
          },
          "outputSchema": {
            "type": "object",
            "required": [
              "summary",
              "findings",
              "evidence"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "proposedPatch": {
                "anyOf": [
                  {
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "verification": {
                "type": "object",
                "required": [
                  "status",
                  "evidence"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "unchecked",
                      "passed",
                      "failed"
                    ]
                  },
                  "evidence": {
                    "type": "array"
                  }
                }
              }
            }
          },
          "requiresTypedResult": true
        },
